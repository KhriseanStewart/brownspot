# OpenRouter (agent LLM)
AGENT_API_KEY=your-openrouter-key
AGENT_MODEL=anthropic/claude-sonnet-5
AGENT_BASE_URL=https://openrouter.ai/api/v1

# Mem0 Platform (optional)
# MEM0_API_KEY=m0-...
# AGENT_USER_ID=khrisean
# AGENT_AGENT_ID=developer
# AGENT_ROLE=developer

# Local Homebrew Postgres (no Docker)
# Local Homebrew:
DATABASE_URL=postgresql://localhost/brownspot
# Railway (private — only works from a service on the same Railway project):
# DATABASE_URL=postgresql://postgres:PASSWORD@postgres-XXX.railway.internal:5432/railway
# Railway public TCP proxy (for Mac / off-network hosts) — from Dashboard → Connect:
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway


# Clerk OAuth (public PKCE client) — required for login
# 1) Clerk Dashboard → configure OAuth application (Public + PKCE)
# 2) Redirect URI allow exactly: http://127.0.0.1:8788/callback
# 3) Fill these:
CLERK_OAUTH_CLIENT_ID=
CLERK_FRONTEND_API=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_SECRET_KEY=

# Auth gate (Codex/Claude style)
BROWNSPOT_AUTH_REQUIRED=true
# Deprecated — chat always requires Clerk login (ignored if set):
BROWNSPOT_DEV_BYPASS=false

BROWNSPOT_API_HOST=127.0.0.1
BROWNSPOT_API_PORT=8787
BROWNSPOT_OAUTH_CALLBACK_PORT=8788


# --- Hosted product mode (other people's installs) ---
# Leave AGENT_API_KEY unset on end-user machines.
# After Clerk login they call BROWNSPOT_API_URL; your server .env holds the key.
# BROWNSPOT_API_URL=https://brownspot-api.terobytez.com
# Deploy: copy this .env to the server (with AGENT_API_KEY) and run: bun run api
