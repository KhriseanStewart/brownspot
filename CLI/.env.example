# OpenRouter (agent LLM)
AGENT_API_KEY=your-openrouter-key
AGENT_MODEL=anthropic/claude-sonnet-5
AGENT_BASE_URL=https://openrouter.ai/api/v1

# Mem0 Platform (optional)
# MEM0_API_KEY=m0-...
# AGENT_USER_ID=khrisean
# AGENT_AGENT_ID=developer
# AGENT_ROLE=developer

# Local Homebrew Postgres (no Docker)
DATABASE_URL=postgresql://localhost/brownspot

# Clerk OAuth (public PKCE client) — required for login
# 1) Clerk Dashboard → configure OAuth application (Public + PKCE)
# 2) Redirect URI allow exactly: http://127.0.0.1:8788/callback
# 3) Fill these:
CLERK_OAUTH_CLIENT_ID=
CLERK_FRONTEND_API=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_SECRET_KEY=

# Auth gate (Codex/Claude style)
BROWNSPOT_AUTH_REQUIRED=true
# Set true only on your machine until Clerk keys work:
BROWNSPOT_DEV_BYPASS=true

BROWNSPOT_API_HOST=127.0.0.1
BROWNSPOT_API_PORT=8787
BROWNSPOT_OAUTH_CALLBACK_PORT=8788
