{
  "name": "brownspot",
  "version": "0.0.5",
  "type": "module",
  "bin": {
    "dotstart": "src/index.ts",
    "agent": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "login": "bun run src/index.ts login",
    "logout": "bun run src/index.ts logout",
    "whoami": "bun run src/index.ts whoami",
    "api": "bun run src/server/index.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:all",
    "build:darwin-arm64": "mkdir -p dist && bun build --compile --target=bun-darwin-arm64 ./src/index.ts --outfile dist/dotstart-darwin-arm64",
    "build:darwin-x64": "mkdir -p dist && bun build --compile --target=bun-darwin-x64 ./src/index.ts --outfile dist/dotstart-darwin-x64",
    "build:linux-x64": "mkdir -p dist && bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile dist/dotstart-linux-x64",
    "build:linux-arm64": "mkdir -p dist && bun build --compile --target=bun-linux-arm64 ./src/index.ts --outfile dist/dotstart-linux-arm64",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64 && bun run build:windows-arm64",
    "build:windows-x64": "mkdir -p dist && bun build --compile --target=bun-windows-x64 ./src/index.ts --outfile dist/dotstart-windows-x64.exe",
    "build:windows-arm64": "mkdir -p dist && bun build --compile --target=bun-windows-arm64 ./src/index.ts --outfile dist/dotstart-windows-arm64.exe",
    "update": "bun run src/index.ts update"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "mem0ai": "^3.2.0",
    "openai": "^7.19.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
